{"step_index":292,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-15T17:30:54Z","model":"gemini-3.8-flash-medium","input_tokens":3279,"cache_read_tokens":181958,"output_tokens":1409,"tool_calls":[{"name":"edit_file","args":{"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\api\\v1\\routers\\videos.py","Replacement":"@router.get(\n    \"/{video_id}/stream\",\n    summary=\"Стриминг видео с поддержкой HTTP Range и проверкой прав доступа\",\n    description=(\n        \"Проверяет права доступа к видео. При успехе возвращает заголовок X-Accel-Redirect \"\n        \"для мгновенной раздачи через Nginx с поддержкой Range-запросов (206 Partial Content).\"\n    ),\n)\nasync def stream_video(\n    video_id: uuid.UUID,\n    db: Annotated[AsyncSession, Depends(get_db)],\n    current_user: Annotated[User | None, Depends(get_optional_user)],\n) -> Response:\n    video_repo = VideoRepository(db)\n    video = await video_repo.get_by_id(video_id)\n    if not video:\n        raise NotFoundException(\"Видео не найдено\")\n\n    access_service = VideoAccessService(db)\n    can_view, reason = await access_service.can_view_video(video, current_user)\n    if not can_view:\n        raise ForbiddenException(reason or \"Доступ запрещен\")\n\n    key = video.processed_object_key or video.raw_object_key\n    if not key:\n        raise NotFoundException(\"Медиафайл видео не готов\")\n\n    # Return 200 Response with X-Accel-Redirect header for Nginx internal dispatch\n    headers = {\n        \"X-Accel-Redirect\": f\"/_internal_s3/{settings.MINIO_VIDEOS_BUCKET}/{key}\",\n        \"Content-Type\": \"video/mp4\",\n    }\n    return Response(content=b\"\", status_code=status.HTTP_200_OK, headers=headers)\n\n\n@router.get(\n    \"/{video_id}/thumbnail\",\n    summary=\"Отдача превью видео с поддержкой X-Accel-Redirect\",\n)\nasync def get_video_thumbnail(\n    video_id: uuid.UUID,\n    db: Annotated[AsyncSession, Depends(get_db)],\n    current_user: Annotated[User | None, Depends(get_optional_user)],\n) -> Response:\n    video_repo = VideoRepository(db)\n    video = await video_repo.get_by_id(video_id)\n    if not video or not video.thumbnail_object_key:\n        raise NotFoundException(\"Превью не найдено\")\n\n    access_service = VideoAccessService(db)\n    can_view, _ = await access_service.can_view_video(video, current_user)\n    if not can_view:\n        raise ForbiddenException(\"Доступ к превью ограничен\")\n\n    headers = {\n        \"X-Accel-Redirect\": f\"/_internal_s3/{settings.MINIO_THUMBNAILS_BUCKET}/{video.thumbnail_object_key}\",\n        \"Content-Type\": \"image/jpeg\",\n    }\n    return Response(content=b\"\", status_code=status.HTTP_200_OK, headers=headers)","Target":"@router.get(\n    \"/{video_id}/stream\",\n    summary=\"Стриминг видео с поддержкой HTTP Range и проверкой прав доступа\",\n    description=(\n        \"Проверяет права доступа к видео. При успехе возвращает заголовок X-Accel-Redirect \"\n        \"для мгновенной раздачи через Nginx с поддержкой Range-запросов (206 Partial Content).\"\n    ),\n)\nasync def stream_video(\n    video_id: uuid.UUID,\n    response: Response,\n    db: Annotated[AsyncSession, Depends(get_db)],\n    current_user: Annotated[User | None, Depends(get_optional_user)],\n) -> Response:\n    video_repo = VideoRepository(db)\n    video = await video_repo.get_by_id(video_id)\n    if not video:\n        raise NotFoundException(\"Видео не найдено\")\n\n    access_service = VideoAccessService(db)\n    can_view, reason = await access_service.can_view_video(video, current_user)\n    if not can_view:\n        raise ForbiddenException(reason or \"Доступ запрещен\")\n\n    key = video.processed_object_key or video.raw_object_key\n    if not key:\n        raise NotFoundException(\"Медиафайл видео не готов\")\n\n    # Pass to Nginx internal location\n    response.headers[\"X-Accel-Redirect\"] = f\"/_internal_s3/{settings.MINIO_VIDEOS_BUCKET}/{key}\"\n    response.headers[\"Content-Type\"] = \"video/mp4\"\n    return response\n\n\n@router.get(\n    \"/{video_id}/thumbnail\",\n    summary=\"Отдача превью видео с поддержкой X-Accel-Redirect\",\n)\nasync def get_video_thumbnail(\n    video_id: uuid.UUID,\n    response: Response,\n    db: Annotated[AsyncSession, Depends(get_db)],\n    current_user: Annotated[User | None, Depends(get_optional_user)],\n) -> Response:\n    video_repo = VideoRepository(db)\n    video = await video_repo.get_by_id(video_id)\n    if not video or not video.thumbnail_object_key:\n        raise NotFoundException(\"Превью не найдено\")\n\n    access_service = VideoAccessService(db)\n    can_view, _ = await access_service.can_view_video(video, current_user)\n    if not can_view:\n        raise ForbiddenException(\"Доступ к превью ограничен\")\n\n    response.headers[\"X-Accel-Redirect\"] = (\n        f\"/_internal_s3/{settings.MINIO_THUMBNAILS_BUCKET}/{video.thumbnail_object_key}\"\n    )\n    response.headers[\"Content-Type\"] = \"image/jpeg\"\n    return response"}}]}
