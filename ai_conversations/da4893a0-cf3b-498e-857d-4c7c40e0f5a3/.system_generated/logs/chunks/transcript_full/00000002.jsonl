{"step_index":156,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-12T15:57:32Z","input_tokens":2559,"cache_read_tokens":91426,"output_tokens":512,"tool_calls":[{"name":"write_file","args":{"Content":"import uuid\nfrom datetime import datetime, timezone\nfrom collections.abc import Sequence\n\nfrom sqlalchemy import select, update\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom app.models.token import RefreshToken\n\n\nclass TokenRepository:\n    def __init__(self, session: AsyncSession):\n        self.session = session\n\n    async def create(\n        self, user_id: uuid.UUID, token_hash: str, expires_at: datetime\n    ) -> RefreshToken:\n        token = RefreshToken(\n            user_id=user_id,\n            token_hash=token_hash,\n            expires_at=expires_at,\n        )\n        self.session.add(token)\n        await self.session.flush()\n        return token\n\n    async def get_valid_by_hash(self, token_hash: str) -> RefreshToken | None:\n        now = datetime.now(timezone.utc)\n        stmt = select(RefreshToken).where(\n            RefreshToken.token_hash == token_hash,\n            RefreshToken.revoked_at.is_(None),\n            RefreshToken.expires_at > now,\n        )\n        res = await self.session.execute(stmt)\n        return res.scalar_one_or_none()\n\n    async def revoke(self, token_id: uuid.UUID) -> None:\n        stmt = (\n            update(RefreshToken)\n            .where(RefreshToken.id == token_id)\n            .values(revoked_at=datetime.now(timezone.utc))\n        )\n        await self.session.execute(stmt)\n\n    async def revoke_all_for_user(self, user_id: uuid.UUID) -> None:\n        stmt = (\n            update(RefreshToken)\n            .where(\n                RefreshToken.user_id == user_id,\n                RefreshToken.revoked_at.is_(None),\n            )\n            .values(revoked_at=datetime.now(timezone.utc))\n        )\n        await self.session.execute(stmt)\n","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\repositories\\token.py"}}]}
{"step_index":157,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-12T15:57:42Z","content":"Created At: 2026-11-12T18:57:42+03:00\nCompleted At: 2026-11-12T18:57:43+03:00\nCreated At: 2026-11-12T18:57:42+03:00\nCompleted At: 2026-11-12T18:57:43+03:00\nCreated file."}
{"step_index":158,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-12T15:57:43Z","input_tokens":2653,"cache_read_tokens":91920,"output_tokens":787,"tool_calls":[{"name":"write_file","args":{"Content":"import uuid\nfrom collections.abc import Sequence\n\nfrom sqlalchemy import delete, select\nfrom sqlalchemy.ext.asyncio import AsyncSession\nfrom sqlalchemy.orm import selectinload\n\nfrom app.models.community import Report\nfrom app.models.enums import ReportStatus\nfrom app.models.video import Video, VideoAccess\n\n\nclass VideoRepository:\n    def __init__(self, session: AsyncSession):\n        self.session = session\n\n    async def get_by_id(self, video_id: uuid.UUID) -> Video | None:\n        stmt = (\n            select(Video)\n            .where(Video.id == video_id)\n            .options(selectinload(Video.owner))\n        )\n        res = await self.session.execute(stmt)\n        return res.scalar_one_or_none()\n\n    async def create(self, video: Video) -> Video:\n        self.session.add(video)\n        await self.session.flush()\n        return video\n\n    async def has_access_grant(\n        self, video_id: uuid.UUID, user_id: uuid.UUID\n    ) -> bool:\n        stmt = select(VideoAccess.id).where(\n            VideoAccess.video_id == video_id,\n            VideoAccess.user_id == user_id,\n        )\n        res = await self.session.execute(stmt)\n        return res.scalar_one_or_none() is not None\n\n    async def grant_access(\n        self, video_id: uuid.UUID, user_id: uuid.UUID, granted_by: uuid.UUID\n    ) -> VideoAccess:\n        access = VideoAccess(\n            video_id=video_id,\n            user_id=user_id,\n            granted_by=granted_by,\n        )\n        self.session.add(access)\n        await self.session.flush()\n        return access\n\n    async def revoke_access(\n        self, video_id: uuid.UUID, user_id: uuid.UUID\n    ) -> bool:\n        stmt = delete(VideoAccess).where(\n            VideoAccess.video_id == video_id,\n            VideoAccess.user_id == user_id,\n        )\n        res = await self.session.execute(stmt)\n        return (res.rowcount or 0) > 0\n\n    async def list_access(self, video_id: uuid.UUID) -> Sequence[VideoAccess]:\n        stmt = (\n            select(VideoAccess)\n            .where(VideoAccess.video_id == video_id)\n            .options(selectinload(VideoAccess.user))\n            .order_by(VideoAccess.created_at.desc())\n        )\n        res = await self.session.execute(stmt)\n        return res.scalars().all()\n\n    async def has_pending_reports(self, video_id: uuid.UUID) -> bool:\n        stmt = select(Report.id).where(\n            Report.video_id == video_id,\n            Report.status == ReportStatus.PENDING,\n        )\n        res = await self.session.execute(stmt)\n        return res.scalar_one_or_none() is not None\n","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\repositories\\video.py"}}]}
{"step_index":159,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-12T15:58:14Z","content":"Created At: 2026-11-12T18:58:14+03:00\nCompleted At: 2026-11-12T18:58:14+03:00\nCreated At: 2026-11-12T18:58:14+03:00\nCompleted At: 2026-11-12T18:58:14+03:00\nCreated file."}
{"step_index":160,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-12T15:58:14Z","input_tokens":2928,"cache_read_tokens":92508,"output_tokens":1164,"tool_calls":[{"name":"write_file","args":{"Content":"import secrets\nimport uuid\nfrom datetime import datetime, timedelta, timezone\n\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom app.core.config import settings\nfrom app.core.exceptions import (\n    BadRequestException,\n    ConflictException,\n    UnauthorizedException,\n)\nfrom app.core.security import (\n    create_access_token,\n    hash_password,\n    hash_refresh_token,\n    verify_password,\n)\nfrom app.models.enums import UserRole\nfrom app.models.user import User\nfrom app.repositories.token import TokenRepository\nfrom app.repositories.user import UserRepository\nfrom app.schemas.auth import (\n    TokenResponse,\n    UserLoginRequest,\n    UserRegisterRequest,\n    UserResponse,\n)\n\n\nclass AuthService:\n    def __init__(self, session: AsyncSession):\n        self.session = session\n        self.user_repo = UserRepository(session)\n        self.token_repo = TokenRepository(session)\n\n    async def register(self, req: UserRegisterRequest) -> tuple[TokenResponse, str]:\n        \"\"\"Register a new user and issue tokens.\"\"\"\n        if await self.user_repo.get_by_email(req.email):\n            raise ConflictException(\"Пользователь с таким email уже существует\")\n        if await self.user_repo.get_by_username(req.username):\n            raise ConflictException(\"Пользователь с таким username уже существует\")\n\n        user = User(\n            email=req.email.lower(),\n            username=req.username,\n            password_hash=hash_password(req.password),\n            role=UserRole.USER,\n            channel_name=req.channel_name or req.username,\n        )\n        await self.user_repo.create(user)\n        await self.session.commit()\n        await self.session.refresh(user)\n\n        return await self._issue_session(user)\n\n    async def login(self, req: UserLoginRequest) -> tuple[TokenResponse, str]:\n        \"\"\"Authenticate user and return (TokenResponse, raw_refresh_token).\"\"\"\n        user = await self.user_repo.get_by_identifier(req.username_or_email)\n        if not user or not verify_password(req.password, user.password_hash):\n            raise UnauthorizedException(\"Неверный логин или пароль\")\n\n        if not user.is_active:\n            raise UnauthorizedException(\"Аккаунт заблокирован\")\n\n        return await self._issue_session(user)\n\n    async def refresh(self, raw_refresh_token: str | None) -> tuple[TokenResponse, str]:\n        \"\"\"Rotate refresh token and issue a new access token.\"\"\"\n        if not raw_refresh_token:\n            raise UnauthorizedException(\"Refresh токен отсутствует\")\n\n        token_hash = hash_refresh_token(raw_refresh_token)\n        token = await self.token_repo.get_valid_by_hash(token_hash)\n        if not token:\n            raise UnauthorizedException(\"Недействительный или отозванный refresh токен\")\n\n        user = await self.user_repo.get_by_id(token.user_id)\n        if not user or not user.is_active:\n            raise UnauthorizedException(\"Пользователь не найден или не активен\")\n\n        # Revoke old token (rotation)\n        await self.token_repo.revoke(token.id)\n        # Issue new session\n        token_resp, new_raw_refresh = await self._issue_session(user)\n        return token_resp, new_raw_refresh\n\n    async def logout(self, raw_refresh_token: str | None) -> None:\n        \"\"\"Revoke current refresh token session.\"\"\"\n        if raw_refresh_token:\n            token_hash = hash_refresh_token(raw_refresh_token)\n            token = await self.token_repo.get_valid_by_hash(token_hash)\n            if token:\n                await self.token_repo.revoke(token.id)\n                await self.session.commit()\n\n    async def _issue_session(self, user: User) -> tuple[TokenResponse, str]:\n        raw_refresh = secrets.token_urlsafe(48)\n        token_hash = hash_refresh_token(raw_refresh)\n        expires_at = datetime.now(timezone.utc) + timedelta(\n            days=settings.REFRESH_TOKEN_EXPIRE_DAYS\n        )\n\n        await self.token_repo.create(user.id, token_hash, expires_at)\n        await self.session.commit()\n\n        access_token = create_access_token(str(user.id), user.role)\n        return (\n            TokenResponse(\n                access_token=access_token,\n                user=UserResponse.model_validate(user),\n            ),\n            raw_refresh,\n        )\n","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\services\\auth.py"}}]}
{"step_index":161,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-12T15:59:05Z","content":"Created At: 2026-11-12T18:59:05+03:00\nCompleted At: 2026-11-12T18:59:05+03:00\nCreated At: 2026-11-12T18:59:05+03:00\nCompleted At: 2026-11-12T18:59:05+03:00\nCreated file."}
{"step_index":162,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-12T15:59:05Z","input_tokens":2124,"cache_read_tokens":94552,"output_tokens":1533,"tool_calls":[{"name":"write_file","args":{"Content":"import uuid\n\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom app.core.exceptions import (\n    BadRequestException,\n    ForbiddenException,\n    NotFoundException,\n)\nfrom app.models.enums import UserRole, VideoStatus, VideoVisibility\nfrom app.models.user import User\nfrom app.models.video import Video\nfrom app.repositories.user import UserRepository\nfrom app.repositories.video import VideoRepository\nfrom app.schemas.video import VideoAccessResponse, VideoAccessUserResponse\n\n\nclass VideoAccessService:\n    def __init__(self, session: AsyncSession):\n        self.session = session\n        self.video_repo = VideoRepository(session)\n        self.user_repo = UserRepository(session)\n\n    async def can_view_video(\n        self, video: Video, user: User | None\n    ) -> tuple[bool, str | None]:\n        \"\"\"\n        Evaluate if a user (or anonymous viewer) has permission to view the video.\n        Returns (has_access, rejection_reason).\n\n        Rules:\n        1. Ready + Public + not hidden -> visible to anyone.\n        2. Hidden by moderator -> visible only to owner and moderators/admins.\n        3. Private -> visible only to owner, users in video_access_list, or moderators/admins\n           (if the video has a pending report under moderation).\n        4. Uploading/Processing/Failed -> visible only to owner and admins.\n        \"\"\"\n        is_owner = bool(user and user.id == video.owner_id)\n        is_moderator_or_admin = bool(\n            user and user.role in (UserRole.MODERATOR, UserRole.ADMIN)\n        )\n\n        # Video is hidden by moderator\n        if video.is_hidden:\n            if is_owner or is_moderator_or_admin:\n                return True, None\n            return False, \"Видео скрыто модератором\"\n\n        # In-flight statuses\n        if video.status != VideoStatus.READY:\n            if is_owner or (user and user.role == UserRole.ADMIN):\n                return True, None\n            return False, \"Видео находится в обработке или недоступно\"\n\n        # Public ready video\n        if video.visibility == VideoVisibility.PUBLIC:\n            return True, None\n\n        # Private video checks\n        if video.visibility == VideoVisibility.PRIVATE:\n            if not user:\n                return False, \"Приватное видео доступно только авторизованным пользователям\"\n\n            if is_owner:\n                return True, None\n\n            # Check if user has explicit access grant\n            if await self.video_repo.has_access_grant(video.id, user.id):\n                return True, None\n\n            # Moderators/admins can view private video ONLY if there is a pending report\n            if is_moderator_or_admin:\n                has_reports = await self.video_repo.has_pending_reports(video.id)\n                if has_reports:\n                    return True, None\n\n            return False, \"Доступ к приватному видео ограничен владельцем\"\n\n        return False, \"Доступ запрещен\"\n\n    async def grant_access(\n        self, video_id: uuid.UUID, owner_user: User, identifier: str\n    ) -> VideoAccessResponse:\n        \"\"\"Owner grants access to a private video to another user by username or email.\"\"\"\n        video = await self.video_repo.get_by_id(video_id)\n        if not video:\n            raise NotFoundException(\"Видео не найдено\")\n\n        if video.owner_id != owner_user.id and owner_user.role != UserRole.ADMIN:\n            raise ForbiddenException(\"Только владелец может управлять доступом к видео\")\n\n        target_user = await self.user_repo.get_by_identifier(identifier)\n        if not target_user:\n            raise NotFoundException(\"Пользователь не найден\")\n\n        if target_user.id == video.owner_id:\n            raise BadRequestException(\"Владелец уже имеет доступ к своему видео\")\n\n        if await self.video_repo.has_access_grant(video.id, target_user.id):\n            raise BadRequestException(\"Доступ этому пользователю уже предоставлен\")\n\n        access = await self.video_repo.grant_access(\n            video_id=video.id,\n            user_id=target_user.id,\n            granted_by=owner_user.id,\n        )\n        await self.session.commit()\n\n        return VideoAccessResponse(\n            id=access.id,\n            video_id=access.video_id,\n            user=VideoAccessUserResponse.model_validate(target_user),\n            created_at=access.created_at,\n        )\n\n    async def revoke_access(\n        self, video_id: uuid.UUID, owner_user: User, user_id: uuid.UUID\n    ) -> None:\n        \"\"\"Owner revokes access to a private video.\"\"\"\n        video = await self.video_repo.get_by_id(video_id)\n        if not video:\n            raise NotFoundException(\"Видео не найдено\")\n\n        if video.owner_id != owner_user.id and owner_user.role != UserRole.ADMIN:\n            raise ForbiddenException(\"Только владелец может управлять доступом к видео\")\n\n        deleted = await self.video_repo.revoke_access(video_id, user_id)\n        if not deleted:\n            raise NotFoundException(\"Запись доступа не найдена\")\n\n        await self.session.commit()\n\n    async def list_access(\n        self, video_id: uuid.UUID, owner_user: User\n    ) -> list[VideoAccessResponse]:\n        \"\"\"Owner lists users granted access to the private video.\"\"\"\n        video = await self.video_repo.get_by_id(video_id)\n        if not video:\n            raise NotFoundException(\"Видео не найдено\")\n\n        if video.owner_id != owner_user.id and owner_user.role != UserRole.ADMIN:\n            raise ForbiddenException(\"Только владелец может просматривать список доступа\")\n\n        grants = await self.video_repo.list_access(video_id)\n        return [\n            VideoAccessResponse(\n                id=g.id,\n                video_id=g.video_id,\n                user=VideoAccessUserResponse.model_validate(g.user),\n                created_at=g.created_at,\n            )\n            for g in grants\n        ]\n","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\services\\access.py"}}]}
{"step_index":163,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-12T16:00:03Z","content":"Created At: 2026-11-12T19:00:03+03:00\nCompleted At: 2026-11-12T19:00:04+03:00\nCreated At: 2026-11-12T19:00:03+03:00\nCompleted At: 2026-11-12T19:00:04+03:00\nCreated file."}
{"step_index":164,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-12T16:00:04Z","input_tokens":2870,"cache_read_tokens":95415,"output_tokens":565,"tool_calls":[{"name":"write_file","args":{"Content":"import uuid\nfrom typing import Annotated\n\nfrom fastapi import Cookie, Depends, Header\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom app.core.database import get_db\nfrom app.core.exceptions import ForbiddenException, UnauthorizedException\nfrom app.core.security import decode_access_token\nfrom app.models.enums import UserRole\nfrom app.models.user import User\nfrom app.repositories.user import UserRepository\n\n\nasync def get_optional_user(\n    db: Annotated[AsyncSession, Depends(get_db)],\n    access_token_cookie: Annotated[str | None, Cookie(alias=\"access_token\")] = None,\n    authorization: Annotated[str | None, Header()] = None,\n) -> User | None:\n    \"\"\"Extract authenticated user if access token is present in cookie or Authorization header.\"\"\"\n    token: str | None = None\n    if access_token_cookie:\n        token = access_token_cookie\n    elif authorization and authorization.startswith(\"Bearer \"):\n        token = authorization.split(\" \", 1)[1]\n\n    if not token:\n        return None\n\n    payload = decode_access_token(token)\n    if not payload:\n        return None\n\n    try:\n        user_id = uuid.UUID(payload[\"sub\"])\n    except (ValueError, KeyError):\n        return None\n\n    user_repo = UserRepository(db)\n    user = await user_repo.get_by_id(user_id)\n    if not user or not user.is_active:\n        return None\n\n    return user\n\n\nasync def get_current_user(\n    user: Annotated[User | None, Depends(get_optional_user)],\n) -> User:\n    \"\"\"Enforce authentication, raising 401 Unauthorized if anonymous.\"\"\"\n    if not user:\n        raise UnauthorizedException(\"Необходима авторизация\")\n    return user\n\n\ndef require_role(*roles: UserRole):\n    \"\"\"Enforce RBAC role requirements.\"\"\"\n\n    async def role_checker(\n        current_user: Annotated[User, Depends(get_current_user)],\n    ) -> User:\n        if current_user.role not in roles:\n            raise ForbiddenException(\"Недостаточно прав доступа для данной роли\")\n        return current_user\n\n    return role_checker\n","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\api\\v1\\dependencies.py"}}]}
{"step_index":165,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-12T16:00:22Z","content":"Created At: 2026-11-12T19:00:22+03:00\nCompleted At: 2026-11-12T19:00:23+03:00\nCreated At: 2026-11-12T19:00:22+03:00\nCompleted At: 2026-11-12T19:00:23+03:00\nCreated file."}
{"step_index":166,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-12T16:00:23Z","input_tokens":2705,"cache_read_tokens":96221,"output_tokens":1398,"tool_calls":[{"name":"write_file","args":{"Content":"from typing import Annotated\n\nfrom fastapi import APIRouter, Cookie, Depends, Request, Response, status\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom app.api.v1.dependencies import get_current_user\nfrom app.core.config import settings\nfrom app.core.exceptions import RateLimitException\nfrom app.core.rate_limit import auth_rate_limiter\nfrom app.core.database import get_db\nfrom app.models.user import User\nfrom app.schemas.auth import (\n    TokenResponse,\n    UserLoginRequest,\n    UserRegisterRequest,\n    UserResponse,\n)\nfrom app.services.auth import AuthService\n\nrouter = APIRouter(prefix=\"/auth\", tags=[\"Auth\"])\n\n\ndef _set_auth_cookies(\n    response: Response, access_token: str, refresh_token: str\n) -> None:\n    \"\"\"Attach httpOnly cookies for access and refresh tokens.\"\"\"\n    response.set_cookie(\n        key=\"access_token\",\n        value=access_token,\n        httponly=True,\n        secure=settings.COOKIE_SECURE,\n        samesite=\"lax\",\n        max_age=settings.ACCESS_TOKEN_EXPIRE_MINUTES * 60,\n        path=\"/\",\n    )\n    response.set_cookie(\n        key=\"refresh_token\",\n        value=refresh_token,\n        httponly=True,\n        secure=settings.COOKIE_SECURE,\n        samesite=\"lax\",\n        max_age=settings.REFRESH_TOKEN_EXPIRE_DAYS * 86400,\n        path=\"/api/v1/auth\",\n    )\n\n\ndef _clear_auth_cookies(response: Response) -> None:\n    \"\"\"Clear session cookies upon logout.\"\"\"\n    response.delete_cookie(\"access_token\", path=\"/\")\n    response.delete_cookie(\"refresh_token\", path=\"/api/v1/auth\")\n\n\n@router.post(\n    \"/register\",\n    response_model=TokenResponse,\n    status_code=status.HTTP_201_CREATED,\n    summary=\"Регистрация нового пользователя\",\n    description=\"Создает пользователя с ролью 'user', выдает токены и устанавливает httpOnly cookies.\",\n)\nasync def register(\n    req: UserRegisterRequest,\n    request: Request,\n    response: Response,\n    db: Annotated[AsyncSession, Depends(get_db)],\n) -> TokenResponse:\n    client_ip = request.client.host if request.client else \"unknown\"\n    allowed, _ = await auth_rate_limiter.is_allowed(f\"register:{client_ip}\")\n    if not allowed:\n        raise RateLimitException(\"Слишком много попыток регистрации. Подождите минуту.\")\n\n    service = AuthService(db)\n    token_resp, raw_refresh = await service.register(req)\n    _set_auth_cookies(response, token_resp.access_token, raw_refresh)\n    return token_resp\n\n\n@router.post(\n    \"/login\",\n    response_model=TokenResponse,\n    summary=\"Авторизация пользователя (логин)\",\n    description=\"Проверяет пароль через Argon2id, выдает JWT и защищает от брутфорса через Redis rate-limit.\",\n)\nasync def login(\n    req: UserLoginRequest,\n    request: Request,\n    response: Response,\n    db: Annotated[AsyncSession, Depends(get_db)],\n) -> TokenResponse:\n    client_ip = request.client.host if request.client else \"unknown\"\n    allowed, _ = await auth_rate_limiter.is_allowed(\n        f\"login:{client_ip}:{req.username_or_email}\"\n    )\n    if not allowed:\n        raise RateLimitException(\"Слишком много попыток входа. Попробуйте через минуту.\")\n\n    service = AuthService(db)\n    token_resp, raw_refresh = await service.login(req)\n    _set_auth_cookies(response, token_resp.access_token, raw_refresh)\n    return token_resp\n\n\n@router.post(\n    \"/refresh\",\n    response_model=TokenResponse,\n    summary=\"Обновление пары токенов\",\n    description=\"Ротация refresh-токена из httpOnly cookie и выпуск нового access_token.\",\n)\nasync def refresh(\n    response: Response,\n    db: Annotated[AsyncSession, Depends(get_db)],\n    refresh_token: Annotated[str | None, Cookie()] = None,\n) -> TokenResponse:\n    service = AuthService(db)\n    token_resp, new_raw_refresh = await service.refresh(refresh_token)\n    _set_auth_cookies(response, token_resp.access_token, new_raw_refresh)\n    return token_resp\n\n\n@router.post(\n    \"/logout\",\n    status_code=status.HTTP_204_NO_CONTENT,\n    summary=\"Выход из системы (logout)\",\n    description=\"Отзывает текущую сессию в БД и очищает httpOnly cookies.\",\n)\nasync def logout(\n    response: Response,\n    db: Annotated[AsyncSession, Depends(get_db)],\n    refresh_token: Annotated[str | None, Cookie()] = None,\n) -> None:\n    service = AuthService(db)\n    await service.logout(refresh_token)\n    _clear_auth_cookies(response)\n\n\n@router.get(\n    \"/me\",\n    response_model=UserResponse,\n    summary=\"Получение профиля текущего пользователя\",\n    description=\"Возвращает данные авторизованного пользователя и его роль (user/moderator/admin).\",\n)\nasync def get_me(\n    current_user: Annotated[User, Depends(get_current_user)],\n) -> UserResponse:\n    return UserResponse.model_validate(current_user)\n","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\api\\v1\\routers\\auth.py"}}]}
