:         # 1. Download raw file from S3\n122:         async with get_s3_client() as s3:\n123:             raw_obj = await s3.get_object(\n124:                 Bucket=settings.MINIO_VIDEOS_BUCKET, Key=raw_key\n125:             )\n126:             with open(local_raw, \"wb\") as f:\n127:                 async for chunk in raw_obj[\"Body\"].iter_chunks():\n128:                     f.write(chunk)\n129: \n130:         # 2. Extract metadata\n131:         duration = await get_video_duration(local_raw)\n132: \n133:         # 3. Transcode to faststart mp4\n134:         await transcode_to_faststart_mp4(local_raw, local_processed)\n135: \n136:         # 4. Generate thumbnail if not provided\n137:         thumbnail_key = custom_thumb_key\n138:         if not thumbnail_key:\n139:             thumb_sec = min(2, max(0, duration - 1))\n140:             await generate_thumbnail(local_raw, local_thumb, at_second=thumb_sec)\n141:             if os.path.exists(local_thumb) and os.path.getsize(local_thumb) > 0:\n142:                 thumbnail_key = f\"thumbnails/{video_id}.jpg\"\n143:                 async with get_s3_client() as s3:\n144:                     with open(local_thumb, \"rb\") as f:\n145:                         await s3.put_object(\n146:                             Bucket=settings.MINIO_THUMBNAILS_BUCKET,\n147:                             Key=thumbnail_key,\n148:                             Body=f.read(),\n149:                             ContentType=\"image/jpeg\",\n150:                         )\n151: \n152:         # 5. Upload processed mp4 to S3\n153:         processed_key = f\"processed/{video_id}.mp4\"\n154:         async with get_s3_client() as s3:\n155:             with open(local_processed, \"rb\") as f:\n156:                 await s3.put_object(\n157:                     Bucket=settings.MINIO_VIDEOS_BUCKET,\n158:                     Key=processed_key,\n159:                     Body=f.read(),\n160:                     ContentType=\"video/mp4\","}
