{"step_index":438,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-15T17:48:59Z","content":"Created At: 2026-11-15T20:48:59+03:00\nCompleted At: 2026-11-15T20:49:00+03:00\nCreated At: 2026-11-15T20:48:59+03:00\nCompleted At: 2026-11-15T20:49:00+03:00\nShowing lines 1-50 of 50\n1: // Helper API client using fetch with credentials: 'include' for httpOnly cookies\n2: \n3: const BASE_URL = '/api/v1';\n4: \n5: export class ApiError extends Error {\n6:   status: number;\n7:   data: any;\n8: \n9:   constructor(status: number, message: string, data?: any) {\n10:     super(message);\n11:     this.status = status;\n12:     this.data = data;\n13:   }\n14: }\n15: \n16: export async function apiRequest<T = any>(\n17:   endpoint: string,\n18:   options: RequestInit = {}\n19: ): Promise<T> {\n20:   const url = `${BASE_URL}${endpoint}`;\n21:   const headers = new Headers(options.headers || {});\n22: \n23:   if (!(options.body instanceof FormData) && !headers.has('Content-Type')) {\n24:     headers.set('Content-Type', 'application/json');\n25:   }\n26: \n27:   const response = await fetch(url, {\n28:     ...options,\n29:     headers,\n30:     credentials: 'include', // sends cookies\n31:   });\n32: \n33:   if (!response.ok) {\n34:     let errorData: any = null;\n35:     let errorMsg = `HTTP Error ${response.status}`;\n36:     try {\n37:       errorData = await response.json();\n38:       errorMsg = errorData.detail || errorMsg;\n39:     } catch {\n40:       // not json\n41:     }\n42:     throw new ApiError(response.status, errorMsg, errorData);\n43:   }\n44: \n45:   if (response.status === 204) {\n46:     return {} as T;\n47:   }\n48: \n49:   return response.json();\n50: }"}
