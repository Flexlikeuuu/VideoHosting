   offset: int = 0,\n43: ) -> list[VideoBaseResponse]:\n44:     video_repo = VideoRepository(db)\n45:     videos = await video_repo.list_feed(sort=sort, limit=limit, offset=offset)\n46:     return [VideoBaseResponse.model_validate(v) for v in videos]\n47: \n48: \n49: @router.get(\n50:     \"/search\","}
