e,\n94:         description=description,\n95:         visibility=visibility,\n96:         video_file=video,\n97:         thumbnail_file=thumbnail,\n98:     )\n99: \n100: \n101: @router.get(\n102:     \"/{video_id}/verify-access\",\n103:     summary=\"Внутренняя проверка прав доступа для Nginx auth_request\",\n104:     description=\"Возвращает 200 OK при наличии доступа или 403 Forbidden.\",\n105: )\n106: async def verify_video_access(\n107:     video_id: uuid.UUID,\n108:     db: Annotated[AsyncSession, Depends(get_db)],\n109:     current_user: Annotated[User | None, Depends(get_optional_user)],\n110: ) -> Response:\n111:     video_repo = VideoRepository(db)\n112:     video = await video_repo.get_by_id(video_id)\n113:     if not video:\n114:         return Response(status_code=status.HTTP_404_NOT_FOUND)\n115: \n116:     access_service = VideoAccessService(db)\n117:     can_view, _ = await access_service.can_view_video(video, current_user)\n118:     if not can_view:\n119:         return Response(status_code=status.HTTP_403_FORBIDDEN)\n120: "}
