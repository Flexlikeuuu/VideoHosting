cess, setReportSuccess] = useState(false);\n46: \n47:   const [accessModalOpen, setAccessModalOpen] = useState(false);\n48:   const [accessTargetUser, setAccessTargetUser] = useState('');\n49:   const [accessList, setAccessList] = useState<VideoAccessGrant[]>([]);\n50:   const [accessError, setAccessError] = useState<string | null>(null);\n51: \n52:   useEffect(() => {\n53:     if (!id) return;\n54:     const fetchVideoData = async () => {\n55:       setLoading(true);\n56:       setError(null);\n57:       try {\n58:         const v = await apiRequest<Video>(`/videos/${id}`);\n59:         setVideo(v);\n60:         setLikesCount(v.likes_count);\n61:         setDislikesCount(v.dislikes_count);\n62: \n63:         // Fetch channel info\n64:         const ch = await apiRequest(`/channels/${v.owner.username}`);\n65:         setIsSubscribed(ch.is_subscribed);\n66:         setSubscribersCount(ch.subscribers_count);\n67: \n68:         // Record view with deduplication\n69:         apiRequest(`/videos/${id}/view`, { method: 'POST' }).catch(() => {});\n70: \n71:         // Fetch comments\n72:         const comms = await apiRequest<Comment[]>(`/videos/${id}/comments`);\n73:         setComments(comms);\n74:       } catch (err: any) {\n75:         setError(err.message || 'Ошибка загрузки видео');\n76:       } finally {\n77:         setLoading(false);\n78:       }\n79:     };\n80:     fetchVideoData();\n81:   }, [id]);\n82: \n83:   const handleReaction = async (val: number) => {\n84:     if (!user || !id) return;\n85:     const nextVal = userReaction === val ? 0 : val;\n86:     try {\n87:       const res = await apiRequest(`/videos/${id}/react`, {\n88:         method: 'POST',\n89:         body: JSON.stringify({ value: nextVal }),\n90:       });\n91:       setLikesCount(res.likes_count);\n92:       setDislikesCount(res.dislikes_count);\n93:       setUserReaction(res.user_reaction);\n94:     } catch (err) {\n95:       console.error(err);\n96:     }\n97:   };\n98: \n99:   const handleSubscribe = async () => {\n100:     if (!user || !video) return;"}
