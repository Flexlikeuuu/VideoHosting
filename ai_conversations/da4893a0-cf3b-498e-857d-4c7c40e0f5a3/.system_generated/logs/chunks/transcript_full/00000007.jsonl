{"step_index":426,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-15T17:47:20Z","model":"gemini-3.8-flash-medium","input_tokens":2429,"cache_read_tokens":248318,"output_tokens":1104,"tool_calls":[{"name":"write_file","args":{"Content":"import React, { useEffect, useState } from 'react';\nimport { apiRequest } from '../api';\nimport { Video } from '../types';\nimport { VideoCard } from '../components/VideoCard';\nimport { Sparkles, TrendingUp } from 'lucide-react';\n\nexport const HomePage: React.FC = () => {\n  const [videos, setVideos] = useState<Video[]>([]);\n  const [sort, setSort] = useState<'new' | 'popular'>('new');\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    const fetchFeed = async () => {\n      setLoading(true);\n      try {\n        const data = await apiRequest<Video[]>(`/videos?sort=${sort}`);\n        setVideos(data);\n      } catch (err) {\n        console.error('Failed to load feed:', err);\n      } finally {\n        setLoading(false);\n      }\n    };\n    fetchFeed();\n  }, [sort]);\n\n  return (\n    <div className=\"space-y-4\">\n      {/* Category Pills / Sorting */}\n      <div className=\"flex gap-2 pb-2\">\n        <button\n          onClick={() => setSort('new')}\n          className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition ${\n            sort === 'new'\n              ? 'bg-black text-white dark:bg-white dark:text-black'\n              : 'bg-gray-100 dark:bg-[#272727] text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-[#3f3f3f]'\n          }`}\n        >\n          <Sparkles className=\"w-4 h-4\" />\n          <span>Новые</span>\n        </button>\n\n        <button\n          onClick={() => setSort('popular')}\n          className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition ${\n            sort === 'popular'\n              ? 'bg-black text-white dark:bg-white dark:text-black'\n              : 'bg-gray-100 dark:bg-[#272727] text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-[#3f3f3f]'\n          }`}\n        >\n          <TrendingUp className=\"w-4 h-4\" />\n          <span>Популярные</span>\n        </button>\n      </div>\n\n      {/* Grid of Video Cards */}\n      {loading ? (\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-x-4 gap-y-8\">\n          {[...Array(8)].map((_, i) => (\n            <div key={i} className=\"animate-pulse flex flex-col gap-3\">\n              <div className=\"aspect-video bg-gray-200 dark:bg-[#272727] rounded-xl\"></div>\n              <div className=\"flex gap-3\">\n                <div className=\"w-9 h-9 rounded-full bg-gray-200 dark:bg-[#272727] shrink-0\"></div>\n                <div className=\"flex-1 space-y-2\">\n                  <div className=\"h-4 bg-gray-200 dark:bg-[#272727] rounded w-5/6\"></div>\n                  <div className=\"h-3 bg-gray-200 dark:bg-[#272727] rounded w-1/2\"></div>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      ) : videos.length === 0 ? (\n        <div className=\"text-center py-20 text-gray-500\">\n          <p className=\"text-lg\">Видео пока нет</p>\n          <p className=\"text-sm mt-1\">Загрузите первое видео через кнопку «Создать»!</p>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-x-4 gap-y-8\">\n          {videos.map((video) => (\n            <VideoCard key={video.id} video={video} />\n          ))}\n        </div>\n      )}\n    </div>\n  );\n};\n","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\frontend\\src\\pages\\HomePage.tsx"}}]}
