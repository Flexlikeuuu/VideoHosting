{"step_index":236,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-15T17:26:05Z","model":"gemini-3.8-flash-medium","input_tokens":2327,"cache_read_tokens":154729,"output_tokens":1528,"tool_calls":[{"name":"write_file","args":{"Content":"import uuid\nfrom typing import BinaryIO\n\nfrom fastapi import UploadFile\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom app.core.config import settings\nfrom app.core.exceptions import BadRequestException\nfrom app.core.queue import enqueue_video_processing\nfrom app.core.storage import get_s3_client\nfrom app.core.validators import is_valid_image_header, is_valid_video_header\nfrom app.models.enums import VideoStatus, VideoVisibility\nfrom app.models.user import User\nfrom app.models.video import Video\nfrom app.repositories.video import VideoRepository\nfrom app.schemas.video import VideoBaseResponse\n\n\nclass MediaService:\n    def __init__(self, session: AsyncSession):\n        self.session = session\n        self.video_repo = VideoRepository(session)\n\n    async def upload_video(\n        self,\n        owner: User,\n        title: str,\n        description: str | None,\n        visibility: VideoVisibility,\n        video_file: UploadFile,\n        thumbnail_file: UploadFile | None = None,\n    ) -> VideoBaseResponse:\n        \"\"\"\n        Validate magic bytes and stream file directly to MinIO without loading into RAM.\n        \"\"\"\n        # 1. Read first chunk to validate magic bytes\n        first_chunk = await video_file.read(1024)\n        if not is_valid_video_header(first_chunk):\n            raise BadRequestException(\n                \"Недопустимый формат файла. Разрешены только видео (MP4, WebM, MKV, MOV)\"\n            )\n\n        video_id = uuid.uuid4()\n        raw_key = f\"raw/{video_id}.bin\"\n        thumbnail_key = None\n\n        # 2. If thumbnail provided, validate and upload it\n        if thumbnail_file and thumbnail_file.filename:\n            thumb_header = await thumbnail_file.read(1024)\n            if not is_valid_image_header(thumb_header):\n                raise BadRequestException(\n                    \"Недопустимый формат превью. Разрешены только JPEG, PNG, WebP\"\n                )\n            thumbnail_key = f\"thumbnails/{video_id}_custom.jpg\"\n\n            async with get_s3_client() as s3:\n                # Stream custom thumbnail\n                async def thumb_stream():\n                    yield thumb_header\n                    while chunk := await thumbnail_file.read(64 * 1024):\n                        yield chunk\n\n                # Upload thumbnail\n                # Since thumbnail is small, read into bytes or multipart\n                thumb_body = thumb_header + await thumbnail_file.read()\n                await s3.put_object(\n                    Bucket=settings.MINIO_THUMBNAILS_BUCKET,\n                    Key=thumbnail_key,\n                    Body=thumb_body,\n                    ContentType=thumbnail_file.content_type or \"image/jpeg\",\n                )\n\n        # 3. Stream raw video to MinIO using multipart upload\n        max_bytes = settings.MAX_VIDEO_SIZE_MB * 1024 * 1024\n        total_size = len(first_chunk)\n\n        async with get_s3_client() as s3:\n            mpu = await s3.create_multipart_upload(\n                Bucket=settings.MINIO_VIDEOS_BUCKET,\n                Key=raw_key,\n                ContentType=video_file.content_type or \"video/mp4\",\n            )\n            upload_id = mpu[\"UploadId\"]\n            parts = []\n            part_number = 1\n\n            current_part_data = bytearray(first_chunk)\n            min_part_size = 5 * 1024 * 1024  # S3 5MB minimum per part\n\n            try:\n                while chunk := await video_file.read(1024 * 1024):\n                    total_size += len(chunk)\n                    if total_size > max_bytes:\n                        raise BadRequestException(\n                            f\"Размер файла превышает лимит {settings.MAX_VIDEO_SIZE_MB} МБ\"\n                        )\n                    current_part_data.extend(chunk)\n\n                    if len(current_part_data) >= min_part_size:\n                        part_res = await s3.upload_part(\n                            Bucket=settings.MINIO_VIDEOS_BUCKET,\n                            Key=raw_key,\n                            PartNumber=part_number,\n                            UploadId=upload_id,\n                            Body=bytes(current_part_data),\n                        )\n                        parts.append({\"PartNumber\": part_number, \"ETag\": part_res[\"ETag\"]})\n                        part_number += 1\n                        current_part_data.clear()\n\n                # Upload remaining part\n                if current_part_data:\n                    part_res = await s3.upload_part(\n                        Bucket=settings.MINIO_VIDEOS_BUCKET,\n                        Key=raw_key,\n                        PartNumber=part_number,\n                        UploadId=upload_id,\n                        Body=bytes(current_part_data),\n                    )\n                    parts.append({\"PartNumber\": part_number, \"ETag\": part_res[\"ETag\"]})\n\n                await s3.complete_multipart_upload(\n                    Bucket=settings.MINIO_VIDEOS_BUCKET,\n                    Key=raw_key,\n                    UploadId=upload_id,\n                    MultipartUpload={\"Parts\": parts},\n                )\n            except Exception:\n                await s3.abort_multipart_upload(\n                    Bucket=settings.MINIO_VIDEOS_BUCKET,\n                    Key=raw_key,\n                    UploadId=upload_id,\n                )\n                raise\n\n        # 4. Save video record in database with status 'processing'\n        video = Video(\n            id=video_id,\n            owner_id=owner.id,\n            title=title,\n            description=description,\n            status=VideoStatus.PROCESSING,\n            visibility=visibility,\n            raw_object_key=raw_key,\n            thumbnail_object_key=thumbnail_key,\n        )\n        await self.video_repo.create(video)\n        await self.session.commit()\n        await self.session.refresh(video)\n\n        # 5. Enqueue processing task\n        await enqueue_video_processing(str(video_id))\n\n        return VideoBaseResponse.model_validate(video)\n","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\services\\media.py"}}]}
{"step_index":237,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-15T17:26:27Z","content":"Created At: 2026-11-15T20:26:27+03:00\nCompleted At: 2026-11-15T20:26:28+03:00\nCreated At: 2026-11-15T20:26:27+03:00\nCompleted At: 2026-11-15T20:26:28+03:00\nCreated file."}
{"step_index":238,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-15T17:26:28Z","model":"gemini-3.8-flash-medium","input_tokens":2448,"cache_read_tokens":156212,"output_tokens":1988,"tool_calls":[{"name":"write_file","args":{"Content":"import asyncio\nimport json\nimport logging\nimport os\nimport shutil\nimport tempfile\nimport uuid\n\nfrom arq.connections import RedisSettings\nfrom sqlalchemy import select, update\n\nfrom app.core.config import settings\nfrom app.core.database import async_session_factory\nfrom app.core.storage import get_s3_client\nfrom app.models.enums import VideoStatus\nfrom app.models.video import Video\n\nlogger = logging.getLogger(\"worker\")\nlogging.basicConfig(level=logging.INFO)\n\n\nasync def get_video_duration(file_path: str) -> int:\n    \"\"\"Use ffprobe to extract duration in seconds.\"\"\"\n    cmd = [\n        \"ffprobe\",\n        \"-v\",\n        \"error\",\n        \"-show_entries\",\n        \"format=duration\",\n        \"-of\",\n        \"default=noprint_wrappers=1:nokey=1\",\n        file_path,\n    ]\n    proc = await asyncio.create_subprocess_exec(\n        *cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE\n    )\n    stdout, stderr = await proc.communicate()\n    if proc.returncode != 0:\n        raise RuntimeError(f\"ffprobe error: {stderr.decode()}\")\n    try:\n        return int(float(stdout.decode().strip()))\n    except Exception:\n        return 0\n\n\nasync def transcode_to_faststart_mp4(input_path: str, output_path: str) -> None:\n    \"\"\"Transcode video to H.264 / AAC MP4 with faststart flag for instant web streaming.\"\"\"\n    cmd = [\n        \"ffmpeg\",\n        \"-y\",\n        \"-i\",\n        input_path,\n        \"-c:v\",\n        \"libx264\",\n        \"-preset\",\n        \"veryfast\",\n        \"-crf\",\n        \"23\",\n        \"-c:a\",\n        \"aac\",\n        \"-b:a\",\n        \"128k\",\n        \"-movflags\",\n        \"+faststart\",\n        output_path,\n    ]\n    proc = await asyncio.create_subprocess_exec(\n        *cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE\n    )\n    _, stderr = await proc.communicate()\n    if proc.returncode != 0:\n        raise RuntimeError(f\"ffmpeg transcode error: {stderr.decode()[:500]}\")\n\n\nasync def generate_thumbnail(input_path: str, output_path: str, at_second: int = 2) -> None:\n    \"\"\"Extract frame at at_second (or 00:00:01) as JPEG thumbnail.\"\"\"\n    cmd = [\n        \"ffmpeg\",\n        \"-y\",\n        \"-ss\",\n        f\"00:00:{at_second:02d}\",\n        \"-i\",\n        input_path,\n        \"-vframes\",\n        \"1\",\n        \"-q:v\",\n        \"2\",\n        output_path,\n    ]\n    proc = await asyncio.create_subprocess_exec(\n        *cmd, stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE\n    )\n    _, stderr = await proc.communicate()\n    if proc.returncode != 0:\n        # Fallback to second 0\n        cmd[2] = \"00:00:00\"\n        proc2 = await asyncio.create_subprocess_exec(*cmd)\n        await proc2.communicate()\n\n\nasync def process_video(ctx: dict, video_id_str: str) -> str:\n    \"\"\"Background task: download raw video, transcode to H.264/AAC, generate thumb, upload.\"\"\"\n    video_id = uuid.UUID(video_id_str)\n    logger.info(f\"Starting processing for video {video_id}\")\n\n    tmp_dir = tempfile.mkdtemp(prefix=f\"video_{video_id}_\")\n    try:\n        async with async_session_factory() as session:\n            video = await session.get(Video, video_id)\n            if not video or not video.raw_object_key:\n                logger.error(f\"Video {video_id} not found or no raw_key\")\n                return f\"Video {video_id} not found\"\n\n            raw_key = video.raw_object_key\n            custom_thumb_key = video.thumbnail_object_key\n\n        local_raw = os.path.join(tmp_dir, \"raw_video.bin\")\n        local_processed = os.path.join(tmp_dir, \"processed.mp4\")\n        local_thumb = os.path.join(tmp_dir, \"thumb.jpg\")\n\n        # 1. Download raw file from S3\n        async with get_s3_client() as s3:\n            raw_obj = await s3.get_object(\n                Bucket=settings.MINIO_VIDEOS_BUCKET, Key=raw_key\n            )\n            with open(local_raw, \"wb\") as f:\n                async for chunk in raw_obj[\"Body\"].iter_chunks():\n                    f.write(chunk)\n\n        # 2. Extract metadata\n        duration = await get_video_duration(local_raw)\n\n        # 3. Transcode to faststart mp4\n        await transcode_to_faststart_mp4(local_raw, local_processed)\n\n        # 4. Generate thumbnail if not provided\n        thumbnail_key = custom_thumb_key\n        if not thumbnail_key:\n            thumb_sec = min(2, max(0, duration - 1))\n            await generate_thumbnail(local_raw, local_thumb, at_second=thumb_sec)\n            if os.path.exists(local_thumb) and os.path.getsize(local_thumb) > 0:\n                thumbnail_key = f\"thumbnails/{video_id}.jpg\"\n                async with get_s3_client() as s3:\n                    with open(local_thumb, \"rb\") as f:\n                        await s3.put_object(\n                            Bucket=settings.MINIO_THUMBNAILS_BUCKET,\n                            Key=thumbnail_key,\n                            Body=f.read(),\n                            ContentType=\"image/jpeg\",\n                        )\n\n        # 5. Upload processed mp4 to S3\n        processed_key = f\"processed/{video_id}.mp4\"\n        async with get_s3_client() as s3:\n            with open(local_processed, \"rb\") as f:\n                await s3.put_object(\n                    Bucket=settings.MINIO_VIDEOS_BUCKET,\n                    Key=processed_key,\n                    Body=f.read(),\n                    ContentType=\"video/mp4\",\n                )\n\n        # 6. Update database record to 'ready'\n        async with async_session_factory() as session:\n            await session.execute(\n                update(Video)\n                .where(Video.id == video_id)\n                .values(\n                    status=VideoStatus.READY,\n                    duration_seconds=duration,\n                    processed_object_key=processed_key,\n                    thumbnail_object_key=thumbnail_key,\n                    error_message=None,\n                )\n            )\n            await session.commit()\n\n        logger.info(f\"Video {video_id} processed successfully to ready status\")\n        return f\"Video {video_id} ready\"\n\n    except Exception as exc:\n        logger.exception(f\"Error processing video {video_id}: {exc}\")\n        async with async_session_factory() as session:\n            await session.execute(\n                update(Video)\n                .where(Video.id == video_id)\n                .values(\n                    status=VideoStatus.FAILED,\n                    error_message=str(exc)[:500],\n                )\n            )\n            await session.commit()\n        return f\"Video {video_id} failed: {exc}\"\n    finally:\n        # Guaranteed cleanup of local temp files\n        shutil.rmtree(tmp_dir, ignore_errors=True)\n\n\nclass WorkerSettings:\n    \"\"\"Arq worker configuration for background video processing.\"\"\"\n\n    functions = [process_video]\n    redis_settings = RedisSettings.from_dsn(settings.REDIS_URL)\n    max_jobs = 4\n    job_timeout = 1800\n","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\worker.py"}}]}
