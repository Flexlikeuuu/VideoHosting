{"step_index":612,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-16T07:38:14Z","content":"Created At: 2026-11-16T10:38:14+03:00\nCompleted At: 2026-11-16T10:38:15+03:00\nCreated At: 2026-11-16T10:38:14+03:00\nCompleted At: 2026-11-16T10:38:15+03:00\nShowing lines 1-29 of 29\n1: import aioboto3\n2: from botocore.config import Config\n3: \n4: from app.core.config import settings\n5: \n6: _s3_session = aioboto3.Session()\n7: \n8: \n9: def get_s3_client():\n10:     \"\"\"Return an async S3 client context manager configured for MinIO.\"\"\"\n11:     return _s3_session.client(\n12:         \"s3\",\n13:         endpoint_url=settings.MINIO_ENDPOINT,\n14:         aws_access_key_id=settings.MINIO_ROOT_USER,\n15:         aws_secret_access_key=settings.MINIO_ROOT_PASSWORD,\n16:         region_name=settings.MINIO_REGION,\n17:         config=Config(signature_version=\"s3v4\", s3={\"addressing_style\": \"path\"}),\n18:     )\n19: \n20: \n21: async def check_storage_connection() -> tuple[bool, str | None]:\n22:     \"\"\"Verify MinIO connectivity and presence of required buckets.\"\"\"\n23:     try:\n24:         async with get_s3_client() as client:\n25:             for bucket in (settings.MINIO_VIDEOS_BUCKET, settings.MINIO_THUMBNAILS_BUCKET):\n26:                 await client.head_bucket(Bucket=bucket)\n27:         return True, None\n28:     except Exception as exc:\n29:         return False, str(exc)"}
