{"step_index":565,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-15T17:59:28Z","content":"Created At: 2026-11-15T20:59:28+03:00\nCompleted At: 2026-11-15T20:59:29+03:00\nCreated At: 2026-11-15T20:59:28+03:00\nCompleted At: 2026-11-15T20:59:29+03:00\nShowing lines 1-28 of 28\n1: #!/usr/bin/env bash\n2: set -euo pipefail\n3: \n4: if [ ! -f .env ]; then\n5:   echo \"[deploy] .env not found, copying from .env.example...\"\n6:   cp .env.example .env\n7: fi\n8: \n9: echo \"[deploy] Building and starting services...\"\n10: docker compose up -d --build\n11: \n12: echo \"[deploy] Waiting for services to become healthy...\"\n13: for i in $(seq 1 30); do\n14:   if docker compose ps --format json | grep -q '\"Health\":\"healthy\"'; then\n15:     if curl -fsS \"http://localhost:${APP_PORT:-80}/api/v1/health\" >/dev/null 2>&1; then\n16:       echo \"[deploy] System is healthy!\"\n17:       echo \"  - App:     http://localhost:${APP_PORT:-80}\"\n18:       echo \"  - Swagger: http://localhost:${APP_PORT:-80}/docs\"\n19:       echo \"  - Health:  http://localhost:${APP_PORT:-80}/api/v1/health\"\n20:       exit 0\n21:     fi\n22:   fi\n23:   sleep 2\n24: done\n25: \n26: echo \"[deploy] Timed out waiting for healthy status. Current containers:\"\n27: docker compose ps\n28: exit 1"}
