{"step_index":53,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-12T15:13:50Z","input_tokens":2303,"cache_read_tokens":61044,"output_tokens":1369,"tool_calls":[{"name":"write_file","args":{"Content":"","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\schemas\\__init__.py"}},{"name":"write_file","args":{"Content":"from typing import Literal\n\nfrom pydantic import BaseModel, Field\n\n\nclass DependencyStatus(BaseModel):\n    \"\"\"Health status of a single infrastructure dependency.\"\"\"\n\n    status: Literal[\"ok\", \"error\"] = Field(..., description=\"Статус доступности сервиса\")\n    detail: str | None = Field(default=None, description=\"Детали ошибки при недоступности\")\n\n\nclass HealthResponse(BaseModel):\n    \"\"\"Aggregated health check response for the API and its dependencies.\"\"\"\n\n    status: Literal[\"ok\", \"degraded\"] = Field(..., description=\"Общий статус системы\")\n    services: dict[str, DependencyStatus] = Field(\n        ...,\n        description=\"Статусы зависимостей: postgres, redis, minio\",\n        examples=[\n            {\n                \"postgres\": {\"status\": \"ok\", \"detail\": None},\n                \"redis\": {\"status\": \"ok\", \"detail\": None},\n                \"minio\": {\"status\": \"ok\", \"detail\": None},\n            }\n        ],\n    )\n","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\schemas\\health.py"}},{"name":"write_file","args":{"Content":"","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\services\\__init__.py"}},{"name":"write_file","args":{"Content":"import asyncio\n\nfrom app.core.database import check_db_connection\nfrom app.core.redis import check_redis_connection\nfrom app.core.storage import check_storage_connection\nfrom app.schemas.health import DependencyStatus, HealthResponse\n\n\nclass HealthService:\n    \"\"\"Service that checks connectivity to PostgreSQL, Redis, and MinIO.\"\"\"\n\n    async def check_all(self) -> tuple[bool, HealthResponse]:\n        \"\"\"Run all dependency checks concurrently and return (is_healthy, payload).\"\"\"\n        (db_ok, db_err), (redis_ok, redis_err), (s3_ok, s3_err) = await asyncio.gather(\n            check_db_connection(),\n            check_redis_connection(),\n            check_storage_connection(),\n        )\n\n        services = {\n            \"postgres\": DependencyStatus(status=\"ok\" if db_ok else \"error\", detail=db_err),\n            \"redis\": DependencyStatus(status=\"ok\" if redis_ok else \"error\", detail=redis_err),\n            \"minio\": DependencyStatus(status=\"ok\" if s3_ok else \"error\", detail=s3_err),\n        }\n        is_healthy = db_ok and redis_ok and s3_ok\n        payload = HealthResponse(\n            status=\"ok\" if is_healthy else \"degraded\",\n            services=services,\n        )\n        return is_healthy, payload\n","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\services\\health.py"}},{"name":"write_file","args":{"Content":"","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\api\\__init__.py"}},{"name":"write_file","args":{"Content":"","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\api\\v1\\__init__.py"}},{"name":"write_file","args":{"Content":"","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\api\\v1\\routers\\__init__.py"}},{"name":"write_file","args":{"Content":"from fastapi import APIRouter, Response, status\n\nfrom app.schemas.health import HealthResponse\nfrom app.services.health import HealthService\n\nrouter = APIRouter(prefix=\"/health\", tags=[\"Health\"])\n\n\n@router.get(\n    \"\",\n    response_model=HealthResponse,\n    summary=\"Проверка состояния системы\",\n    description=(\n        \"Проверяет подключение к PostgreSQL, Redis и MinIO (включая наличие бакетов \"\n        \"`videos` и `thumbnails`). Возвращает 200 OK при полной работоспособности \"\n        \"или 503 Service Unavailable, если хотя бы одна зависимость недоступна.\"\n    ),\n    responses={\n        200: {\"description\": \"Все зависимости доступны\"},\n        503: {\"description\": \"Одна или несколько зависимостей недоступны\", \"model\": HealthResponse},\n    },\n)\nasync def health_check(response: Response) -> HealthResponse:\n    \"\"\"Return health status of API and backing infrastructure services.\"\"\"\n    service = HealthService()\n    is_healthy, payload = await service.check_all()\n    if not is_healthy:\n        response.status_code = status.HTTP_503_SERVICE_UNAVAILABLE\n    return payload\n","Overwrite":true,"Path":"c:\\Users\\kiril\\OneDrive\\Рабочий стол\\Лабы\\AQA\\YoutubeTask\\backend\\app\\api\\v1\\routers\\health.py"}}]}
