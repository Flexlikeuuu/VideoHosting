{"step_index":454,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-15T17:49:54Z","content":"Created At: 2026-11-15T20:49:54+03:00\nCompleted At: 2026-11-15T20:49:54+03:00\nCreated At: 2026-11-15T20:49:54+03:00\nCompleted At: 2026-11-15T20:49:54+03:00\nShowing lines 1-68 of 68\n1: from typing import Annotated\n2: \n3: from fastapi import APIRouter, Depends\n4: from sqlalchemy.ext.asyncio import AsyncSession\n5: \n6: from app.api.v1.dependencies import get_current_user, get_optional_user\n7: from app.core.database import get_db\n8: from app.core.exceptions import NotFoundException\n9: from app.models.enums import UserRole\n10: from app.models.user import User\n11: from app.repositories.user import UserRepository\n12: from app.repositories.video import VideoRepository\n13: from app.schemas.social import ChannelProfileResponse, SubscriptionResponse\n14: from app.schemas.video import VideoBaseResponse\n15: from app.services.social import SocialService\n16: \n17: router = APIRouter(prefix=\"/channels\", tags=[\"Channels\"])\n18: \n19: \n20: @router.get(\n21:     \"/{username}\",\n22:     response_model=ChannelProfileResponse,\n23:     summary=\"Профиль канала, подписчики и статус подписки\",\n24: )\n25: async def get_channel_profile(\n26:     username: str,\n27:     db: Annotated[AsyncSession, Depends(get_db)],\n28:     current_user: Annotated[User | None, Depends(get_optional_user)],\n29: ) -> ChannelProfileResponse:\n30:     service = SocialService(db)\n31:     return await service.get_channel_profile(username, current_user)\n32: \n33: \n34: @router.get(\n35:     \"/{username}/videos\",\n36:     response_model=list[VideoBaseResponse],\n37:     summary=\"Список видео канала (владельцу отображаются также private и hidden)\",\n38: )\n39: async def get_channel_videos(\n40:     username: str,\n41:     db: Annotated[AsyncSession, Depends(get_db)],\n42:     current_user: Annotated[User | None, Depends(get_optional_user)],\n43: ) -> list[VideoBaseResponse]:\n44:     user_repo = UserRepository(db)\n45:     channel_user = await user_repo.get_by_username(username)\n46:     if not channel_user:\n47:         raise NotFoundException(\"Канал не найден\")\n48: \n49:     is_owner = bool(current_user and current_user.id == channel_user.id)\n50:     is_moderator = bool(current_user and current_user.role in (UserRole.MODERATOR, UserRole.ADMIN))\n51: \n52:     video_repo = VideoRepository(db)\n53:     videos = await video_repo.list_channel_videos(channel_user.id, is_owner=is_owner, is_moderator=is_moderator)\n54:     return [VideoBaseResponse.model_validate(v) for v in videos]\n55: \n56: \n57: @router.post(\n58:     \"/{username}/subscribe\",\n59:     response_model=SubscriptionResponse,\n60:     summary=\"Подписаться / отписаться от канала (toggle)\",\n61: )\n62: async def toggle_subscription(\n63:     username: str,\n64:     db: Annotated[AsyncSession, Depends(get_db)],\n65:     current_user: Annotated[User, Depends(get_current_user)],\n66: ) -> SubscriptionResponse:\n67:     service = SocialService(db)\n68:     return await service.toggle_subscription(username, current_user)"}
