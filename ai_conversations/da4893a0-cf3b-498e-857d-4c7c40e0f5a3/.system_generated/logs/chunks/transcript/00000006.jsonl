\n    };\\n\\n    fetchChannelData();\\n  }, [username]);\\n\\n  const handleSubscribe = async () => {\\n    if (!user || !channel) return;\\n    setSubscribing(true);\\n    try {\\n      const res = await apiRequest(`/channels/${channel.username}/subscribe`, {\\n        method: 'POST',\\n      });\\n      setChannel({\\n        ...channel,\\n        is_subscribed: res.is_subscribed,\\n        subscribers_count: res.subscribers_count,\\n      });\\n    } catch (err) {\\n      console.error(err);\\n    } finally {\\n      setSubscribing(false);\\n    }\\n  };\\n\\n  if (loading) {\\n    return (\\n      <div className=\\\"max-w-6xl mx-auto space-y-6 animate-pulse\\\">\\n        <div className=\\\"h-40 bg-gray-200 dark:bg-[#2\n<truncated 6850 bytes>","Overwrite":"true","Path":"\"c:\\\\Users\\\\kiril\\\\OneDrive\\\\Рабочий стол\\\\Лабы\\\\AQA\\\\YoutubeTask\\\\frontend\\\\src\\\\pages\\\\ChannelPage.tsx\""}}],"truncated_fields":["tool_calls"]}
