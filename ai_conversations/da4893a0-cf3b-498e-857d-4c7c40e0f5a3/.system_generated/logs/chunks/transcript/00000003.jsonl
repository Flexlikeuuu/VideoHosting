{"step_index":232,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-15T17:25:48Z","model":"gemini-3.8-flash-medium","input_tokens":2231,"cache_read_tokens":154005,"output_tokens":474,"tool_calls":[{"name":"write_file","args":{"Content":"\"def is_valid_video_header(chunk: bytes) -> bool:\\n    \\\"\\\"\\\"\\n    Validate that file begins with valid video magic bytes:\\n    - MP4 / MOV: 'ftyp' at offset 4 (e.g. ftypisom, ftypmp42, etc.)\\n    - WebM / MKV: Matroska/EBML header \\\\x1a\\\\x45\\\\xdf\\\\xa3\\n    \\\"\\\"\\\"\\n    if len(chunk) < 8:\\n        return False\\n\\n    # Check EBML / WebM / MKV\\n    if chunk.startswith(b\\\"\\\\x1a\\\\x45\\\\xdf\\\\xa3\\\"):\\n        return True\\n\\n    # Check MP4 / MOV / QuickTime: 4 bytes box size + 'ftyp'\\n    if len(chunk) >= 12 and chunk[4:8] == b\\\"ftyp\\\":\\n        return True\\n\\n    return False\\n\\n\\ndef is_valid_image_header(chunk: bytes) -> bool:\\n    \\\"\\\"\\\"\\n    Validate that file begins with valid image magic bytes:\\n    - JPEG: \\\\xff\\\\xd8\\\\xff\\n    - PNG: \\\\x89PNG\\\\r\\\\n\\\\x1a\\\\n\\n    - WebP: RIFF....WEBP\\n    \\\"\\\"\\\"\\n    if len(chunk) < 4:\\n        return False\\n\\n    # JPEG\\n    if chunk.startswith(b\\\"\\\\xff\\\\xd8\\\\xff\\\"):\\n        return True\\n\\n    # PNG\\n    if chunk.startswith(b\\\"\\\\x89PNG\\\\r\\\\n\\\\x1a\\\\n\\\"):\\n        return True\\n\\n    # WebP: 'RIFF' + 4 bytes size + 'WEBP'\\n    if len(chunk) >= 12 and chunk.startswith(b\\\"RIFF\\\") and chunk[8:12] == b\\\"WEBP\\\":\\n        return True\\n\\n    return False\\n\"","Overwrite":"true","Path":"\"c:\\\\Users\\\\kiril\\\\OneDrive\\\\Рабочий стол\\\\Лабы\\\\AQA\\\\YoutubeTask\\\\backend\\\\app\\\\core\\\\validators.py\""}}]}
