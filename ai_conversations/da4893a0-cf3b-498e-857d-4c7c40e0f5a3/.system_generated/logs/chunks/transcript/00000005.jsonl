 className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition ${\n46:             sort === 'popular'\n47:               ? 'bg-black text-white dark:bg-white dark:text-black'\n48:               : 'bg-gray-100 dark:bg-[#272727] text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-[#3f3f3f]'\n49:           }`}\n50:         >\n51:           <TrendingUp className=\"w-4 h-4\" />\n52:           <span>Популярные</span>\n53:         </button>\n54:       </div>\n55: \n56:       {/* Grid of Video Cards */}\n57:       {loading ? (\n58:         <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-x-4 gap-y-8\">\n59:           {[...Array(8)].map((_, i) => (\n60:             <div key={i} className=\"animate-pulse flex flex-col gap-3\">\n61:               <div className=\"aspect-video bg-gray-200 dark:bg-[#272727] rounded-xl\"></div>\n62:               <div className=\"flex gap-3\">\n63:                 <div className=\"w-9 h-9 rounded-full bg-gray-200 dark:bg-[#272727] shrink-0\"></div>\n64:                 <div className=\"flex-1 space-y-2\">\n65:                   <div className=\"h-4 bg-gray-200 dark:bg-[#272727] rounded w-5/6\"></div>\n66:                   <div className=\"h-3 bg-gray-200 dark:bg-[#272727] rounded w-1/2\"></div>\n67:                 </div>\n68:               </div>\n69:             </div>\n70:           ))}\n71:         </div>\n72:       ) : videos.length === 0 ? (\n73:         <div className=\"text-center py-20 text-gray-500\">\n74:           <p className=\"text-lg\">Видео пока нет</p>\n75:           <p className=\"text-sm mt-1\">Загрузите первое видео через кнопку «Создать»!</p>\n76:         </div>\n77:       ) : (\n78:         <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-x-4 gap-y-8\">\n79:           {videos.map((video) => (\n80:             <VideoCard key={video.id} video={video} />\n81:           ))}\n82:         </div>\n83:       )}\n84:     </