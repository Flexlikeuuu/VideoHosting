te a signed JWT access token.\"\"\"\n48:     try:\n49:         payload = jwt.decode(\n50:             token,\n51:             settings.SECRET_KEY,\n52:             algorithms=[settings.JWT_ALGORITHM],\n53:             options={\"require\": [\"sub\", \"role\", \"exp\", \"type\"]},\n54:         )\n55:         if payload.get(\"type\") != \"access\":\n56:             return None\n57:         return payload\n58:     except (jwt.PyJWTError, Exception):\n59:         return None"}
