"content-type\"))\n82:         assert thumb_resp.status_code == 200\n83:         assert len(thumb_resp.content) > 0\n84: \n85:         print(\"=== ALL STAGE 4 MEDIA PIPELINE CHECKS PASSED ===\")\n86: \n87: \n88: if __name__ == \"__main__\":\n89:     asyncio.run(main())"}
